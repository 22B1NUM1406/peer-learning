# Энэ файлыг .env нэрээр хуулж бөглөнө. .env-ийг git-д хэзээ ч оруулахгүй.

# Neon-ий холболтын мөр (Dashboard > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

PORT=3000
SESSION_DAYS=7
UPLOAD_DIR=./uploads

# npm run db:seed ажиллуулахад үүсэх админ
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
